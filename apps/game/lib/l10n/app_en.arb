      },
      "total": {
        "type": "int",
        "format": "decimalPattern",
        "example": "20"
      }
    }
  },

  "winNextUp": "Next up: {name}",
  "@winNextUp": {
    "description": "The chapter card's line naming the figurine family this chapter unlocks (frame 2.8, spec §7.2). {name} is figurineName.",
    "placeholders": {
      "name": {
        "type": "String",
        "example": "The Baker Family"
      }
    }
  },

  "winChapterDone": "Chapter complete! Your prize is next.",
  "@winChapterDone": {
    "description": "The chapter card's line on the chapter's last level (frame 2.8 at 20 / 20, spec §7.2)."
  },

  "figurineName": "{figurine, select, classic{The Classic Family} sailor{The Sailor Family} baker{The Baker Family} other{}}",
  "@figurineName": {
    "description": "A museum figurine family's name (spec §7.2, frames 1.5, 2.8). {figurine} is the museum item id; ids without a design name are empty and their line is hidden.",
    "placeholders": {
      "figurine": {
        "type": "String",
        "example": "classic"
      }
    }
  },

  "chapterRibbon": "CHAPTER {number} · {name}",
  "@chapterRibbon": {
    "description": "The ribbon on a chapter's first level, drawn over the ui_chapter_ribbon animation, fading after about 2 s (frame 4.7, spec §7.1). {name} is chapterName. The band fits about 22 characters; longer text shrinks.",
    "placeholders": {
      "number": {
        "type": "int",
        "format": "decimalPattern",
        "example": "2"
      },
      "name": {
        "type": "String",
        "example": "Rainy Café Corner"
      }
    }
  },

