# ── 8. The home-screen widget (local habits stage 4) ───────────────────────
# The OS checks flutter drive can't make. Each records PASS or FAIL.
widget_cold_link_ios() {
  local link="nesty-dev://daily" container shot="$OUT/screenshots/w_cold_link.png"
  container="$(xcrun simctl get_app_container "$DEVICE_ID" "$APP_ID" 2>/dev/null)"
  if [ -n "$container" ] && [ -d "$container/PlugIns/NestyWidget.appex" ]; then
    record "widget: NestyWidget.appex is in the installed app" PASS "$container/PlugIns"
  else
    record "widget: NestyWidget.appex is in the installed app" FAIL "no PlugIns/NestyWidget.appex under ${container:-the app container}"
  fi
  xcrun simctl terminate "$DEVICE_ID" "$APP_ID" >/dev/null 2>&1 || true
  sleep 2
  if xcrun simctl openurl "$DEVICE_ID" "$link" >"$OUT/logs/widget_cold_link.log" 2>&1; then
    sleep 12
    xcrun simctl io "$DEVICE_ID" screenshot "$shot" >>"$OUT/logs/widget_cold_link.log" 2>&1 || true
    if xcrun simctl spawn "$DEVICE_ID" launchctl list 2>/dev/null | grep -q "$APP_ID" && [ -s "$shot" ]; then
      record "widget: the cold link $link starts the app" PASS "screenshots/w_cold_link.png: a person judges that it shows the Daily"
    elif [ -s "$shot" ]; then
      # iOS 17 and later ask "Open in ...?" before a URL from simctl opens
      # an app (a widget's tap doesn't), and no tool here can tap it (D314).
      record "widget: the cold link $link starts the app" SKIP "iOS asks to confirm simctl's link, which a person taps (screenshots/w_cold_link.png); the cold start is the Android cold link's and widget_link_test's"
    else
      record "widget: the cold link $link starts the app" FAIL "no screenshot (logs/widget_cold_link.log)"
    fi
  else
    record "widget: the cold link $link starts the app" FAIL "simctl openurl failed (logs/widget_cold_link.log)"
  fi
}

widget_cold_link_android() {
  local provider="$APP_ID/com.futrix.nesty.widget.NestyWidgetProvider"
  local shot="$OUT/screenshots/w_cold_link.png" log="$OUT/logs/widget_cold_link.log"
  if adb -s "$DEVICE_ID" shell dumpsys appwidget 2>/dev/null | grep -qF "$provider"; then
    record "widget: dumpsys appwidget lists the provider" PASS "$provider"
  else
    record "widget: dumpsys appwidget lists the provider" FAIL "$provider is not listed"
  fi
  adb -s "$DEVICE_ID" shell am force-stop "$APP_ID" >/dev/null 2>&1 || true
  sleep 2
  adb -s "$DEVICE_ID" shell am start -W -a android.intent.action.VIEW \
    -d nesty-dev://daily "$APP_ID" >"$log" 2>&1
  sleep 12
  adb -s "$DEVICE_ID" exec-out screencap -p >"$shot" 2>>"$log" || true
  if grep -q 'Status: ok' "$log" && [ -s "$shot" ] &&
    adb -s "$DEVICE_ID" shell dumpsys activity activities 2>/dev/null | grep -E 'topResumedActivity|mResumedActivity' | grep -qF "$APP_ID"; then
    record "widget: the cold link nesty-dev://daily starts the app" PASS "screenshots/w_cold_link.png: a person judges that it shows the Daily"
  else
    record "widget: the cold link nesty-dev://daily starts the app" FAIL "not started, or no screenshot (logs/widget_cold_link.log)"
  fi
}

# Builds the real dev app (not a test target) and installs it over the last
# scenario's save, so the cold link opens a seeded, unlocked game.
widget_install_dev_app() {
  if [ "$PLATFORM" = ios ]; then
    run_step "build and install the dev app for the cold link" widget_install bash -c \
      "cd '$GAME' && flutter build ios --simulator --debug --flavor dev -t lib/main_dev.dart && xcrun simctl install '$DEVICE_ID' build/ios/iphonesimulator/Runner.app"
  else
    run_step "build and install the dev app for the cold link" widget_install bash -c \
      "cd '$GAME' && flutter build apk --debug --flavor dev -t lib/main_dev.dart && adb -s '$DEVICE_ID' install -r build/app/outputs/flutter-apk/app-dev-debug.apk"
  fi
}

if wants widget; then
  section "The home-screen widget ($DAILY_DATE, fresh installs)"
  if [ "$PLATFORM" = ios ]; then
    # The widget's pure logic, in RunnerTests (by UDID, never a name).
    # Without parallel testing: xcodebuild otherwise runs on a clone, and a
    # clone needs its source shut down, so it shut this device down and
    # every drive after it found no device (D314).
    run_step "xcodebuild test: RunnerTests (the widget's logic)" widget_runner_tests \
      xcodebuild test -workspace "$GAME/ios/Runner.xcworkspace" -scheme dev \
      -configuration Debug-dev -destination "platform=iOS Simulator,id=$DEVICE_ID" \
      -parallel-testing-enabled NO
    # Booted again by UDID if anything still shut it down.
    if ! xcrun simctl list devices | grep -q "$DEVICE_ID) (Booted)"; then
      echo "  booting $DEVICE_ID again after xcodebuild"
      xcrun simctl boot "$DEVICE_ID" >/dev/null 2>&1 || true
      xcrun simctl bootstatus "$DEVICE_ID" -b >/dev/null 2>&1 || true
    fi
  fi
  # `ready` runs last, so the save left on the device is a seeded, unlocked one.
  for scenario in locked paused solved ready; do
    drive_fresh "home_widget_test $scenario (screenshots w_*)" \
      "home_widget_$scenario" "home_widget_$scenario" \
      home_widget_test.dart --dart-define=NESTY_FAKE_DATE="$DAILY_DATE" \
      --dart-define=NESTY_WIDGET_SCENARIO="$scenario" --timeout 600
  done
  if widget_install_dev_app; then
    if [ "$PLATFORM" = ios ]; then widget_cold_link_ios; else widget_cold_link_android; fi
  fi
fi

# ── 9. The daily reminder (optional, Android) ──────────────────────────────
case ",$ONLY," in
  *",reminder,"*)
    if [ "$PLATFORM" != android ]; then
      # simctl privacy can't grant notifications, and flutter drive can't tap
      # iOS's permission alert: the owner checks a real reminder on a phone.
      section "Daily reminder"
      echo "  skipped on iOS: Android only (nesty-test --android --only reminder)"
    fi
    ;;
esac
if wants reminder; then
  section "Daily reminder (fresh install, Android)"
  {
    uninstall_app
    APK="$GAME/build/app/outputs/flutter-apk/app-dev-debug.apk"
    SDK="$(adb -s "$DEVICE_ID" shell getprop ro.build.version.sdk | tr -d '\r')"
    # Built and installed first, so POST_NOTIFICATIONS (API 33+) can be
    # granted before the app ever runs; flutter drive then reinstalls the
    # same APK with `adb install -r`, which keeps the grant.
    if run_step "build the reminder_test APK" reminder_build \
      bash -c "cd '$GAME' && flutter build apk --debug --flavor dev -t integration_test/reminder_test.dart" &&
      run_step "install it" reminder_install adb -s "$DEVICE_ID" install -r "$APK"; then
      if [ "${SDK:-0}" -ge 33 ]; then
        run_step "pm grant POST_NOTIFICATIONS (API $SDK)" reminder_grant \
          adb -s "$DEVICE_ID" shell pm grant "$APP_ID" android.permission.POST_NOTIFICATIONS
      else
        record "POST_NOTIFICATIONS" PASS "API $SDK: no runtime permission to grant"
      fi
      if run_step "reminder_test: on -> one pending, off -> none" reminder \
        drive reminder_test.dart --use-application-binary "$APK" --timeout 600; then
        response_to "$OUT/reminder.json"
      fi
    fi
  }
fi

# ── Summary ────────────────────────────────────────────────────────────────
if [ "$SHUTDOWN" = 1 ] && [ "$BOOTED_HERE" = 1 ]; then
  if [ "$PLATFORM" = ios ]; then
    xcrun simctl shutdown "$DEVICE_ID" >/dev/null 2>&1 || true
  else
    adb -s "$DEVICE_ID" emu kill >/dev/null 2>&1 || true
  fi
fi

{
  echo "nesty-test $STAMP ($PLATFORM${DEVICE_ID:+, $DEVICE_ID})"
  for i in "${!NAMES[@]}"; do
    printf '%-5s %s  %s\n' "${RESULTS[$i]}" "${NAMES[$i]}" "${NOTES[$i]}"
  done
} >"$OUT/summary.txt"

section "Summary"
for i in "${!NAMES[@]}"; do
  case "${RESULTS[$i]}" in
    PASS) mark="${GREEN}PASS${RESET}" ;;
    SKIP) mark="${DIM}SKIP${RESET}" ;;
    *) mark="${RED}FAIL${RESET}" ;;
  esac
  printf '  %s  %s %s\n' "$mark" "${NAMES[$i]}" "${DIM}${NOTES[$i]}${RESET}"
done
echo
echo "  logs, screenshots and summary.txt: $OUT"
if [ "$FAILED" = 0 ]; then
  echo "  ${GREEN}${BOLD}All steps passed.${RESET}"
  exit 0
fi
echo "  ${RED}${BOLD}Some steps failed.${RESET}"
exit 1
