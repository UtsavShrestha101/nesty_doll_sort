  "@chapterName": {
    "description": "A chapter's name, which is its board theme's name (spec §7.1, §12.4; frames 4.6, 4.7, 7.7). {theme} is the theme id.",
    "placeholders": {
      "theme": {
        "type": "String",
        "example": "ch02"
      }
    }
