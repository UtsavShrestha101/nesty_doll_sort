#!/usr/bin/env bash
# nesty-test: a full test run of the game on a simulator or emulator, from a
# fresh install (README "Testing").
#
#   1. host checks (skip: --device-only), CI's list except codegen drift:
#      dart format, flutter analyze, every test suite, nesty_core's web parity
#      (node; chrome and dart2wasm when Chrome is installed), the drift checks
#      of the design files, assets, FX specs and TODO index, the level bundle
#      and solver fixtures, and the admin's web build
#   2. boots the device and shows it (the Simulator app, or the emulator window)
#   3. the playthrough, with its screenshots (integration_test/playthrough_test.dart),
#      including the race against rival 1 (M7 phase 2), slowed by NESTY_RACE_PACE_MS
#   4. kill mid-level and resume: phase A, a real kill, phase B, compared,
#      twice: level 3 (M3) and level 1 during its tutorial (E9,
#      NESTY_RESUME_SCENARIO=l1)
#   5. the daily puzzle's fingerprint, compared with nesty_core's own level (M3)
#   6. M7 phase 4's device files (Claude Design's m7-3) and the daily gift's, each from a fresh
#      install with its own screenshots:
#      board        board_layouts_test.dart: levels 31-200's presets, the tall
#                   glass case, the top-shelf tower, the iced tower's tag, two
#                   +1 Slots, the tap nudge, the drag hover, the hint's counter
#      race         race_loss_test.dart three times: `loss` (the rival paced at
#                   NESTY_RACE_PACE_MS=250 finishes first; Rematch, Pause and
#                   Settings, Leave race's confirm, New race), `oom` (Out of
#                   Moves in a race, the rival never finishing) and `restart`
#                   (the rival starting over, 9.3c, at 1,000 ms a move)
#      meta         meta_screens_test.dart three times: `returning` (Home,
#                   Chapters and the level card, the Museum and a figurine,
#                   Records, the Shop's Forest Bear, its detail, Ocean in play,
#                   the themes, a theme in play), `finale` (12.1) and
#                   `complete` (12.2, and the Museum with all ten families)
#      daily_states daily_states_test.dart eight times, with NESTY_FAKE_DATE:
#                   `chest` (a 6-day streak's day-7 chest, the offer's time
#                   picker), `paused` (paused, then relit), `saved` (a freeze
#                   covers yesterday, 5.2), `settings` (the toggles, Reduce
#                   motion, Relaxed mode's toast and free undo, Large symbols),
#                   `welcome` (the welcome-back card after 3 days away, its
#                   Play to the win, then gone) and `month` (the month of
#                   played days on 2026-10-31, whatever --date says),
#                   `locked` (the Daily before Level 2, 12.14, and its Play)
#                   and `archive` (a past day played from the month's window
#                   on 2026-11-03, so the window crosses into October)
#      gift         login_gift_test.dart five times, with NESTY_FAKE_DATE: `ready`
#                   (Home's dot, the sheet, a claim's flight, the claimed look),
#                   `claimed` (no dot, "Tomorrow"), `day7` (the chest, Open,
#                   Collect, the slot into the tally, the finished track),
#                   `clock_back` (a wound-back clock claims nothing) and `hint`
#                   (a hint day: the flight into the tally under the coin pill)
#      overlays     overlays_test.dart: the replay's helper note, the milestone
#                   chest's flights, the 10th bonus chest, the generating card,
#                   Out of Moves with the free undos spent, the Undo popup, the
#                   animated undo, the +1 Slot limit, soft-stuck with Restart
#                   glowing, the intro loops
#   7. M7 phase 5's device files, each scenario from a fresh install:
#      faults       faults_test.dart eight times (NESTY_FAULT_SCENARIO): a race
#                   that fails to set up, the reminder granted and denied, the
#                   generating card held, a bonus level that fails, the
#                   splash's storage and content errors, the splash held once
#                   its art is in (10.8's 00b shot), each installed
#                   through the test-only seam bootstrap(beforeRunApp:)
#      semantics    semantics_tour_test.dart four times (NESTY_A11Y_SCENARIO):
#                   race, race_loss, game and meta; every screen's semantics in
#                   traversal order, kept as semantics_<scenario>.json
#      locales      locales_test.dart three times (NESTY_TEST_LOCALE), one per
#                   script family: de through the real language picker, hi and
#                   ja seeded; Home to a race's Leave race, every screen shot
#                   as l10n-<code>-NN_<screen>, every assertion read from the
#                   locale's own catalog
#   8. the home-screen widget (local habits stage 4), from fresh installs:
#      widget       iOS first runs RunnerTests (xcodebuild test, by UDID: the
#                   widget's pure logic). Then home_widget_test.dart four
#                   times, with NESTY_FAKE_DATE and NESTY_WIDGET_SCENARIO:
#                   `locked` (the snapshot says locked; a warm link moves
#                   nothing), `paused`, `solved` (the daily is played to its
#                   win and the store reads today solved) and `ready`; each
#                   reads the store back through the channel, checks its
#                   facts (iOS's App Group resolves, Android's prefs file)
#                   and pushes the warm link nesty-dev://daily. Then the OS
#                   checks flutter drive can't make, on the real dev app
#                   installed over the last scenario's save: iOS, the
#                   NestyWidget.appex inside the installed app and the cold
#                   link (`simctl openurl`); Android, the provider in
#                   `dumpsys appwidget` and the cold link (`am start`), each
#                   with a screenshot w_cold_link. Placing the widget on a home
#                   screen and its pixels stay with a person.
#   9. optional, Android only, never in the default run (--only reminder): the
#      daily reminder (M7 phase 3), with POST_NOTIFICATIONS granted by
#      `pm grant` before launch so no OS dialog opens: on in Settings, one
#      pending reminder; off, none (integration_test/reminder_test.dart)
#
# Every run writes its logs, screenshots and summary to
# apps/game/build/nesty-test/<timestamp>/ (or $NESTY_TEST_OUT), and exits 1
# when any step fails. The dev flavor with real services; the app id is
# com.futrix.nesty.dev, uninstalled before each fresh step.
#
# Devices: NESTY_TEST_IOS_DEVICE and NESTY_TEST_ANDROID_DEVICE are the
# defaults behind --device. --android-size WxH@dpi (or NESTY_TEST_ANDROID_SIZE)
# sets the emulator's screen with `adb shell wm size` and `wm density` after
# boot, and the exit trap resets both, only if this run set them:
# 1170x2532@480 is 390x844 dp, the iPhone 16e's size (phase 5's fidelity
# pairs).

set -uo pipefail

usage() {
  cat <<'USAGE'
Usage: nesty-test [options]

  --ios                 run on an iOS simulator (the default)
  --android             run on an Android emulator
  --device <name|id>    iOS: a simulator name or UDID (default
                        $NESTY_TEST_IOS_DEVICE, else "iPhone 16 Pro")
                        Android: an AVD name or a running serial such as
                        emulator-5554 (default $NESTY_TEST_ANDROID_DEVICE,
                        else flutter_emulator)
  --android-size <WxH@dpi>
                        Android: the screen in pixels and its density, set
                        after boot and reset on exit (default
                        $NESTY_TEST_ANDROID_SIZE; 1170x2532@480 is 390x844 dp)
  --device-only         skip the host checks (analyze and the test suites)
  --only <steps>        comma-separated subset of: gates,playthrough,resume,daily,
                        board,race,meta,daily_states,gift,overlays,faults,
                        semantics,locales,widget,reminder (reminder: Android only, and only when named)
  --date <yyyymmdd>     the daily's date (default 20260926, the core golden)
  --headless            Android: start the emulator without a window
  --shutdown            shut the device down at the end if this run booted it
  -h, --help            this help

Examples:
  nesty-test                          everything on the iPhone 16 Pro simulator
  nesty-test --device-only            skip the host checks
  nesty-test --android --only playthrough
  nesty-test --device-only --only board,race   two of phase 4's device files
  nesty-test --device-only --only faults,semantics   phase 5's device files
  nesty-test --device-only --only locales   de, hi and ja on the device (5B)
  nesty-test --device-only --device 87BDED37-4095-49C4-811A-3E2B7D5FB38B
                                      the iPhone 16e (390x844), by its UDID
  nesty-test --android --device-only --android-size 1170x2532@480
                                      the emulator at 390x844 dp
  nesty-test --device-only --only widget   the home-screen widget's data and link (stage 4)
  nesty-test --android --only reminder   the optional Android reminder check
USAGE
}

# ── Options ────────────────────────────────────────────────────────────────
PLATFORM=ios
DEVICE=""
ANDROID_SIZE="${NESTY_TEST_ANDROID_SIZE:-}"
DEVICE_ONLY=0
ONLY=""
DAILY_DATE="${NESTY_TEST_DATE:-20260926}"
# The rival's pace for the playthrough's race (ms per move; a dev debug
# build only honours it): slow enough that the solver's moves always win.
RACE_PACE_MS=600000
# race_loss_test's `loss` scenario: fast enough that the computer finishes
# first while the player never moves.
RACE_LOSS_PACE_MS=250
# race_loss_test's `restart` scenario: slow enough to see "Starting over".
RACE_RESTART_PACE_MS=1000
HEADLESS=0
SHUTDOWN=0
while [ $# -gt 0 ]; do
  case "$1" in
    --ios) PLATFORM=ios ;;
    --android) PLATFORM=android ;;
    --device) DEVICE="${2:?--device needs a value}"; shift ;;
    --android-size) ANDROID_SIZE="${2:?--android-size needs a value}"; shift ;;
    --device-only) DEVICE_ONLY=1 ;;
    --only) ONLY="${2:?--only needs a value}"; shift ;;
    --date) DAILY_DATE="${2:?--date needs a value}"; shift ;;
    --headless) HEADLESS=1 ;;
    --shutdown) SHUTDOWN=1 ;;
    -h|--help) usage; exit 0 ;;
    *) echo "nesty-test: unknown option $1" >&2; usage >&2; exit 64 ;;
  esac
  shift
done

# The device's default comes from the environment, per platform, so a
# shell can pin one (never the owner's own simulator) for every run.
if [ -z "$DEVICE" ]; then
  if [ "$PLATFORM" = ios ]; then
    DEVICE="${NESTY_TEST_IOS_DEVICE:-}"
  else
    DEVICE="${NESTY_TEST_ANDROID_DEVICE:-}"
  fi
fi
if [ -n "$ANDROID_SIZE" ] && ! [[ "$ANDROID_SIZE" =~ ^[0-9]+x[0-9]+@[0-9]+$ ]]; then
  echo "nesty-test: --android-size takes WxH@dpi, such as 1170x2532@480 (got $ANDROID_SIZE)" >&2
  exit 64
fi

SKIP_DEVICE=0
wants() {
  [ "$SKIP_DEVICE" = 1 ] && [ "$1" != gates ] && return 1
  # The reminder check is optional: it runs only when --only names it, and
  # only on Android (iOS skips it: see step 9).
  if [ "$1" = reminder ]; then
    [ "$PLATFORM" = android ] || return 1
    case ",$ONLY," in *",reminder,"*) return 0 ;; *) return 1 ;; esac
  fi
  if [ -n "$ONLY" ]; then
    case ",$ONLY," in *",$1,"*) return 0 ;; *) return 1 ;; esac
  fi
  [ "$1" = gates ] && [ "$DEVICE_ONLY" = 1 ] && return 1
  return 0
}

# ── Paths ──────────────────────────────────────────────────────────────────
SCRIPT="${BASH_SOURCE[0]}"
while [ -L "$SCRIPT" ]; do
  LINK="$(readlink "$SCRIPT")"
  case "$LINK" in /*) SCRIPT="$LINK" ;; *) SCRIPT="$(dirname "$SCRIPT")/$LINK" ;; esac
done
ROOT="$(cd "$(dirname "$SCRIPT")/../.." && pwd)"
GAME="$ROOT/apps/game"
APP_ID=com.futrix.nesty.dev
STAMP="$(date +%Y%m%d-%H%M%S)"
OUT="${NESTY_TEST_OUT:-$GAME/build/nesty-test/$STAMP}"
mkdir -p "$OUT/logs" "$OUT/screenshots"
ln -sfn "$OUT" "$GAME/build/nesty-test/latest" 2>/dev/null || true
# Keep only the newest runs: each holds ~130 MB of screenshots and logs, and
# the disk filling up is what failed the owner's run (2026-09-29).
if [ -z "${NESTY_TEST_OUT:-}" ]; then
  ls -1dt "$GAME/build/nesty-test"/[0-9]*-[0-9]*/ 2>/dev/null |
    tail -n +$((${NESTY_TEST_KEEP_RUNS:-5} + 1)) |
    while IFS= read -r old; do rm -rf "$old"; done
fi

# ── Output helpers ─────────────────────────────────────────────────────────
if [ -t 1 ]; then
  BOLD=$'\033[1m'; GREEN=$'\033[32m'; RED=$'\033[31m'; DIM=$'\033[2m'; RESET=$'\033[0m'
else
  BOLD=""; GREEN=""; RED=""; DIM=""; RESET=""
fi
NAMES=(); RESULTS=(); NOTES=()
FAILED=0

record() { # name PASS|FAIL|SKIP note
  NAMES+=("$1"); RESULTS+=("$2"); NOTES+=("$3")
  case "$2" in
    PASS) echo "  ${GREEN}PASS${RESET} $1 ${DIM}$3${RESET}" ;;
    SKIP) echo "  ${DIM}SKIP $1 ($3)${RESET}" ;;
    *) FAILED=1; echo "  ${RED}FAIL${RESET} $1 ${DIM}$3${RESET}" ;;
  esac
}

section() { echo; echo "${BOLD}== $1${RESET}"; }

# Runs a command with its output in logs/<name>.log; records PASS or FAIL.
# A device step can hang at attach: the app launches, but flutter drive never
# finds its VM service, so its --timeout never starts (twice on the iPhone 16e
# in the 2026-10-05 M7 gate). Its log then ends at the build line. After
# ATTACH_HANG_S seconds of silence there, the step is stopped, with its whole
# process tree, and fails. Override with NESTY_TEST_ATTACH_HANG_S.
# The same limit stops a step whose driver found the app but whose test never
# started ("Flutter Driver extension is taking a long time to become
# available" and no "mm:ss +n" line since: an Android emulator starved by the
# host, 2026-10-08), which Android's logcat would otherwise keep looking alive.
ATTACH_HANG_S="${NESTY_TEST_ATTACH_HANG_S:-480}"
kill_tree() { # pid: its descendants first, then itself
  local child
  for child in $(pgrep -P "$1"); do kill_tree "$child"; done
  kill -KILL "$1" 2>/dev/null
}
watch_attach() { # pid log
  local pid="$1" log="$2" age last slow_since=""
  while kill -0 "$pid" 2>/dev/null; do
    sleep 15
    [ -f "$log" ] || continue
    if [ -z "$slow_since" ] &&
      grep -q 'Flutter Driver extension is taking a long time' "$log"; then
      slow_since=$(date +%s)
    fi
    if [ -n "$slow_since" ] &&
      [ $(( $(date +%s) - slow_since )) -ge "$ATTACH_HANG_S" ] &&
      ! grep -qE '[0-9][0-9]:[0-9][0-9] \+[0-9]+' "$log"; then
      echo "nesty-test: stopped ${ATTACH_HANG_S} s after the driver extension was slow, with no test started: the app never answered the driver (an overloaded machine?)" >>"$log"
      kill_tree "$pid"
      return
    fi
    age=$(( $(date +%s) - $(stat -f %m "$log" 2>/dev/null || stat -c %Y "$log") ))
    last="$(grep -v '^[[:space:]]*$' "$log" | tail -1)"
    if [ "$age" -ge "$ATTACH_HANG_S" ] &&
      printf '%s' "$last" | grep -qE 'Xcode build done|Installing .*\.apk'; then
      echo "nesty-test: stopped after ${age} s at \"${last:0:40}\": flutter drive never attached to the app (no VM service)" >>"$log"
      kill_tree "$pid"
      return
    fi
  done
}

run_step() { # name log-name command...
  local name="$1" log="$OUT/logs/$2.log"; shift 2
  local start=$SECONDS rc pid watcher
  echo "  … $name ${DIM}(log: logs/$(basename "$log"))${RESET}"
  "$@" >"$log" 2>&1 &
  pid=$!
  watch_attach "$pid" "$log" &
  watcher=$!
  wait "$pid"; rc=$?
  kill "$watcher" 2>/dev/null; wait "$watcher" 2>/dev/null
  if [ "$rc" -eq 0 ]; then
    record "$name" PASS "$((SECONDS - start)) s"
    return 0
  fi
  record "$name" FAIL "$((SECONDS - start)) s, see logs/$(basename "$log")"
  tail -n 15 "$log" | sed 's/^/      /'
  if grep -q 'No space left on device' "$log"; then
    echo "      ${RED}${BOLD}The disk filled up during this step${RESET}${RED} (\"No space left on device\" in its log): free some space and run it again.${RESET}"
  fi
  return 1
}

die() { echo "${RED}nesty-test: $*${RESET}" >&2; exit 2; }

command -v flutter >/dev/null || die "flutter is not on PATH"
command -v python3 >/dev/null || die "python3 is not on PATH"

# A device run builds the app, installs it and saves ~90 screenshots, and a
# full disk fails it deep inside flutter drive with a driver stack trace
# (2026-09-29: "No space left on device" writing flutter_driver_commands_0.log).
# So check first. Override the floor with NESTY_TEST_MIN_FREE_GB.
MIN_FREE_GB="${NESTY_TEST_MIN_FREE_GB:-8}"
check_disk() { # when
  local free_kb
  free_kb="$(df -Pk "$ROOT" | awk 'NR == 2 { print $4 }')"
  [ -n "$free_kb" ] || return 0
  if [ "$free_kb" -lt $((MIN_FREE_GB * 1024 * 1024)) ]; then
    die "only $((free_kb / 1024 / 1024)) GB free on this disk $1; a run needs at least $MIN_FREE_GB GB (builds, the simulator's writes, screenshots). Free some space, or set NESTY_TEST_MIN_FREE_GB."
  fi
}
check_disk "at the start"

echo "${BOLD}nesty-test${RESET} — $PLATFORM, output in $OUT"
cd "$ROOT" || die "can't enter $ROOT"
flutter pub get >"$OUT/logs/pub_get.log" 2>&1 || die "flutter pub get failed (logs/pub_get.log)"

# ── 1. Host checks ─────────────────────────────────────────────────────────
# CI's checks (.github/workflows/ci.yaml), so a green run here means a green
# CI. The one CI check left out is codegen drift: it regenerates every
# generated file, which a local run shouldn't do to a working tree.

# CI's format step, portable to macOS (no `grep -z`), and it also covers new
# untracked files. Generated files keep their generators' format.
format_check() {
  cd "$ROOT" && git ls-files --cached --others --exclude-standard -- '*.dart' \
    | grep -vE '\.(g|freezed|gr|config|gen)\.dart$|/lib/l10n/app_localizations[^/]*\.dart$|/firebase_options[^/]*\.dart$' \
    | tr '\n' '\0' | xargs -0 dart format --output=none --set-exit-if-changed
}

have_chrome() {
  [ -n "${CHROME_EXECUTABLE:-}" ] ||
    [ -x "/Applications/Google Chrome.app/Contents/MacOS/Google Chrome" ] ||
    command -v google-chrome >/dev/null 2>&1
}

if wants gates; then
  section "Host checks"
  run_step "dart format (CI's list; generated files skipped)" format format_check
  run_step "flutter analyze --fatal-infos --fatal-warnings" analyze \
    flutter analyze --fatal-infos --fatal-warnings
  run_step "nesty_core: dart test" core bash -c "cd '$ROOT/packages/nesty_core' && dart test"
  if command -v node >/dev/null 2>&1; then
    run_step "nesty_core: web parity and goldens on node" core_node bash -c \
      "cd '$ROOT/packages/nesty_core' && dart test -p node test/parity test/generator/golden_test.dart"
  else
    record "nesty_core: web parity on node" SKIP "node is not installed; CI runs it"
  fi
  if have_chrome; then
    run_step "nesty_core: web parity on chrome and dart2wasm" core_chrome bash -c \
      "cd '$ROOT/packages/nesty_core' && dart test -p chrome test/parity && dart test -p chrome -c dart2wasm test/parity"
  else
    record "nesty_core: web parity on chrome and dart2wasm" SKIP "Chrome is not installed; CI runs it"
  fi
  run_step "nesty_render: flutter test" render bash -c "cd '$ROOT/packages/nesty_render' && flutter test"
  run_step "game: flutter test" game_tests bash -c "cd '$GAME' && flutter test --timeout 90s"
  # The overflow suite in every other locale (l10n.md §6.2): en/de/hi/ja
  # run five sizes, the rest the two small phones; English ran above.
  for code in de es fr hi id ja pt pt_BR tr; do
    run_step "game: overflow suite in $code" "overflow_$code" bash -c \
      "cd '$GAME' && flutter test test/overflow --timeout 120s --dart-define=NESTY_TEST_LOCALE=$code"
  done
  run_step "admin: flutter test" admin_tests bash -c "cd '$ROOT/apps/admin' && flutter test"
  run_step "tools: dart test" tools_tests bash -c "cd '$ROOT/tools' && dart test"
  run_step "design tokens, icons, assets, FX specs, font subsets, widget strings and TODO index are current" drift bash -c \
    "cd '$ROOT' && dart run nesty_tools:gen_design_tokens --check && dart run nesty_tools:gen_nesty_icons --check && dart run nesty_tools:sync_design_assets --check && dart run nesty_tools:gen_fx_spec --check && dart run nesty_tools:gen_font_subsets --check && dart run nesty_tools:gen_widget_strings --check && dart run nesty_tools:todo_index --check"
  # The widget's Xcode target is generated (tools/ios/add_widget_target.rb):
  # --check needs ruby and the xcodeproj gem (CocoaPods ships it), so it runs
  # on a Mac with CocoaPods and is skipped, with a note, anywhere else.
  if [ "$(uname)" = Darwin ] && command -v ruby >/dev/null 2>&1 &&
    ruby -e 'require "xcodeproj"' >/dev/null 2>&1; then
    run_step "the widget's Xcode target is current" widget_target \
      bash -c "cd '$ROOT' && ruby tools/ios/add_widget_target.rb --check"
  else
    record "the widget's Xcode target is current" SKIP "needs macOS, ruby and the xcodeproj gem"
  fi
  # The widget's Kotlin logic (WidgetTimeline, WidgetJson, WidgetFit) on the
  # JVM. gradlew and local.properties are git-ignored and exist only after a
  # first `flutter build apk` in a checkout, so a missing one is made that way.
  if command -v java >/dev/null 2>&1 || [ -n "${JAVA_HOME:-}" ]; then
    run_step "android: widget JVM tests" android_jvm bash -c \
      "cd '$GAME' && { { [ -x android/gradlew ] && [ -f android/local.properties ]; } || flutter build apk --debug --flavor dev -t lib/main_dev.dart; } && cd android && ./gradlew :app:testDevDebugUnitTest -Ptarget=lib/main_dev.dart"
  else
    record "android: widget JVM tests" SKIP "no JDK; CI runs them"
  fi
  run_step "level bundle and solver fixtures" levels bash -c \
    "cd '$ROOT' && dart run nesty_tools:nesty_levels bundle check && dart run nesty_tools:nesty_levels fixtures check"
  run_step "admin: flutter build web" admin_web bash -c \
    "cd '$ROOT/apps/admin' && flutter build web -t lib/main_prod.dart"
fi

DEVICE_STEPS=0
for step in playthrough resume daily board race meta daily_states gift overlays faults semantics locales widget reminder; do
  if wants "$step"; then DEVICE_STEPS=1; fi
done

# ── 2. The device ──────────────────────────────────────────────────────────
DEVICE_ID=""
BOOTED_HERE=0
EMULATOR_PID=""

boot_ios() {
  command -v xcrun >/dev/null || { echo "  xcrun not found (Xcode)"; return 1; }
  local want="${DEVICE:-iPhone 16 Pro}"
  DEVICE_ID="$(xcrun simctl list devices available -j | python3 -c '
import json, re, sys
want = sys.argv[1]
devices = json.load(sys.stdin)["devices"]
def version(runtime):
    return [int(n) for n in re.findall(r"\d+", runtime.split(".")[-1])]
found = []
for runtime, entries in devices.items():
    if "iOS" not in runtime:
        continue
    for d in entries:
        if d["udid"] == want or d["name"] == want:
            found.append((d["state"] == "Booted", version(runtime), d["udid"]))
found.sort(reverse=True)
if found:
    booted, _, udid = found[0]
    print(udid, "Booted" if booted else "Shutdown")
' "$want")"
  [ -n "$DEVICE_ID" ] || { echo "  no available iOS simulator named or with UDID \"$want\" (xcrun simctl list devices available)"; return 1; }
  local state="${DEVICE_ID#* }"
  DEVICE_ID="${DEVICE_ID%% *}"
  if [ "$state" != Booted ]; then
    echo "  booting $want ($DEVICE_ID)"
    xcrun simctl boot "$DEVICE_ID" >/dev/null 2>&1 || true
    BOOTED_HERE=1
  fi
  xcrun simctl bootstatus "$DEVICE_ID" -b >/dev/null 2>&1 || { echo "  the simulator didn't boot"; return 1; }
  open -a Simulator --args -CurrentDeviceUDID "$DEVICE_ID" >/dev/null 2>&1 || true
  echo "  ${GREEN}ready${RESET} $want ($DEVICE_ID)"
}

boot_android() {
  command -v adb >/dev/null || { echo "  adb not found (Android SDK platform-tools)"; return 1; }
  if [ -n "$DEVICE" ] && adb devices | grep -q "^$DEVICE[[:space:]]*device"; then
    DEVICE_ID="$DEVICE"
  else
    local avd="${DEVICE:-flutter_emulator}"
    local emulator="${ANDROID_HOME:-$HOME/Library/Android/sdk}/emulator/emulator"
    [ -x "$emulator" ] || emulator="$(command -v emulator || true)"
    [ -n "$emulator" ] || { echo "  the Android emulator binary wasn't found"; return 1; }
    local before
    before="$(adb devices | awk 'NR>1 && $1 ~ /^emulator-/ {print $1}')"
    local window=""
    [ "$HEADLESS" = 1 ] && window=-no-window
    echo "  starting the $avd emulator"
    # With audio: the playthrough checks that every sound and music file
    # loads, and SoLoud can't start its output stream on an emulator started
    # with -no-audio (miniaudio's ma_device_start fails, so the game keeps
    # its sounds off, as it must on a device without audio).
    # shellcheck disable=SC2086 # $window is one flag or nothing
    "$emulator" -avd "$avd" $window -no-snapshot-save -no-boot-anim \
      >"$OUT/logs/emulator.log" 2>&1 &
    EMULATOR_PID=$!
    BOOTED_HERE=1
    local i serial=""
    for i in $(seq 1 120); do
      serial="$(adb devices | awk 'NR>1 && $1 ~ /^emulator-/ {print $1}' | grep -vxF "$before" | head -1)"
      [ -n "$serial" ] && break
      sleep 2
    done
    [ -n "$serial" ] || { echo "  the emulator didn't come up (logs/emulator.log)"; return 1; }
    DEVICE_ID="$serial"
  fi
  local i
  for i in $(seq 1 120); do
    [ "$(adb -s "$DEVICE_ID" shell getprop sys.boot_completed 2>/dev/null | tr -d '\r')" = 1 ] && break
    sleep 2
  done
  echo "  ${GREEN}ready${RESET} $DEVICE_ID (API $(adb -s "$DEVICE_ID" shell getprop ro.build.version.sdk | tr -d '\r'))"
}

# --android-size: the emulator's screen for this run (`wm size`, `wm
# density`). restore_android_size, the exit trap, resets only what this run
# set, so a size set by someone else stays.
SIZE_SET=0
DENSITY_SET=0
apply_android_size() {
  [ -n "$ANDROID_SIZE" ] || return 0
  local pixels="${ANDROID_SIZE%@*}" dpi="${ANDROID_SIZE#*@}"
  if adb -s "$DEVICE_ID" shell wm size "$pixels" >/dev/null 2>&1; then
    SIZE_SET=1
  else
    echo "  ${RED}wm size $pixels failed${RESET}"
    return 1
  fi
  if adb -s "$DEVICE_ID" shell wm density "$dpi" >/dev/null 2>&1; then
    DENSITY_SET=1
  else
    echo "  ${RED}wm density $dpi failed${RESET}"
    return 1
  fi
  echo "  screen: $(adb -s "$DEVICE_ID" shell wm size | tr -d '\r' | tail -1), $(adb -s "$DEVICE_ID" shell wm density | tr -d '\r' | tail -1)"
}

restore_android_size() {
  [ -n "$DEVICE_ID" ] || return 0
  if [ "$SIZE_SET" = 1 ]; then
    adb -s "$DEVICE_ID" shell wm size reset >/dev/null 2>&1 || true
    SIZE_SET=0
  fi
  if [ "$DENSITY_SET" = 1 ]; then
    adb -s "$DEVICE_ID" shell wm density reset >/dev/null 2>&1 || true
    DENSITY_SET=0
  fi
}
trap restore_android_size EXIT

uninstall_app() {
  if [ "$PLATFORM" = ios ]; then
    xcrun simctl terminate "$DEVICE_ID" "$APP_ID" >/dev/null 2>&1 || true
    xcrun simctl uninstall "$DEVICE_ID" "$APP_ID" >/dev/null 2>&1 || true
  else
    adb -s "$DEVICE_ID" uninstall "$APP_ID" >/dev/null 2>&1 || true
  fi
}

kill_app() {
  if [ "$PLATFORM" = ios ]; then
    xcrun simctl terminate "$DEVICE_ID" "$APP_ID"
  else
    adb -s "$DEVICE_ID" shell am force-stop "$APP_ID"
  fi
}

# flutter drive of one integration test on the device (the dev flavor).
drive() { # target extra-args...
  local target="$1" out rc; shift
  # flutter drive's debug log of driver commands holds every screenshot's
  # data and grew to 1.1 GB in one run (the 2026-10-05 gate, under the disk
  # floor), so each step starts it empty; nothing reads it.
  : >"$GAME/build/flutter_driver_commands_0.log" 2>/dev/null || true
  out="$(mktemp)"
  (cd "$GAME" && flutter drive --flavor dev \
    --driver test_driver/integration_test.dart \
    --target "integration_test/$target" -d "$DEVICE_ID" "$@") 2>&1 | tee "$out"
  rc=${PIPESTATUS[0]}
  # flutter drive exits 0 when it is stopped before its test ran (a SIGTERM,
  # 2026-10-08), so a step passes only with the driver's own success line.
  if [ "$rc" -eq 0 ] && ! grep -q '^All tests passed\.' "$out"; then
    echo "nesty-test: flutter drive exited 0 without \"All tests passed.\": the test never finished"
    rc=1
  fi
  rm -f "$out"
  return "$rc"
}

response_to() { # file
  cp "$GAME/build/integration_response_data.json" "$1" 2>/dev/null
}

if [ "$DEVICE_STEPS" = 1 ]; then
  section "Device"
  check_disk "before the device steps"
  # The driver saves each screenshot there (test_driver/integration_test.dart);
  # every device file prefixes its own names (b_, r_, meta-, d_, ov_).
  export NESTY_SCREENSHOT_DIR="$OUT/screenshots"
  if [ "$PLATFORM" = ios ]; then boot_ios; else boot_android; fi
  if [ $? -ne 0 ] || [ -z "$DEVICE_ID" ]; then
    record "boot the $PLATFORM device" FAIL "the device steps were skipped"
    SKIP_DEVICE=1
  elif [ -n "$ANDROID_SIZE" ]; then
    if [ "$PLATFORM" = android ]; then
      if ! apply_android_size; then
        record "set the screen to $ANDROID_SIZE" FAIL "the device steps were skipped"
        SKIP_DEVICE=1
      fi
    else
      echo "  --android-size is for Android; iOS runs at the simulator's own size"
    fi
  fi
fi

# ── 3. The playthrough ─────────────────────────────────────────────────────
if wants playthrough; then
  section "Playthrough (fresh install)"
  uninstall_app
  if run_step "playthrough_test (screenshots)" playthrough \
    drive playthrough_test.dart --dart-define=NESTY_FAKE_DATE="$DAILY_DATE" \
      --dart-define=NESTY_RACE_PACE_MS="$RACE_PACE_MS" --timeout 1800; then
    echo "      $(ls "$OUT/screenshots" | wc -l | tr -d ' ') screenshots in screenshots/"
    # E13 (m7-design §13): the time from main() to level 1's first playable
    # frame on this fresh install, and until the splash's exit transition
    # is over, which the playthrough reports. Both are recorded, not held to
    # a threshold (the owner's device check notes the seconds, Q114). Since
    # phase 4 the first launch fades into level 1 over 400 ms (frame 10.8):
    # the board is playable under the fade, so the first number counts from
    # main() to that frame as before, and the second includes the fade.
    response_to "$OUT/playthrough.json"
    if e13="$(python3 -c '
import json, sys
e13 = json.load(open(sys.argv[1]))["e13"]
playable, alone = e13["launchToLevel1PlayableMs"], e13["launchToLevel1AloneMs"]
print(f"{playable} ms from main() to the first playable frame, {alone} ms to level 1 alone on screen")
' "$OUT/playthrough.json" 2>/dev/null)"; then
      record "E13: launch to level 1 playable" PASS "$e13"
    else
      record "E13: launch to level 1 playable" FAIL "no e13 in the playthrough's response data"
    fi
  fi
fi

# ── 4. Kill mid-level and resume ───────────────────────────────────────────
# Each pair from a fresh install: `l3` (M3: level 3 with an undo and a +1
# Slot, resumed from Home's PLAY) and `l1` (E9: one move on level 1 during
# its tutorial, reopened by the splash itself).
resume_pair() { # scenario what
  local scenario="$1" what="$2" sfx=""
  [ "$scenario" = l3 ] || sfx="_$scenario"
  uninstall_app
  if run_step "phase A ($scenario): $what, keep the app running" "resume_phase_a$sfx" \
    drive resume_phase_a_test.dart --dart-define=NESTY_RESUME_SCENARIO="$scenario" \
      --keep-app-running --timeout 600; then
    response_to "$OUT/resume_a$sfx.json"
    if run_step "kill the app ($scenario)" "kill$sfx" kill_app &&
      run_step "phase B ($scenario): relaunch, the same board" "resume_phase_b$sfx" \
        drive resume_phase_b_test.dart --dart-define=NESTY_RESUME_SCENARIO="$scenario" \
          --timeout 600; then
      response_to "$OUT/resume_b$sfx.json"
      if note="$(python3 - "$OUT/resume_a$sfx.json" "$OUT/resume_b$sfx.json" <<'PY'
import json, sys
a = json.load(open(sys.argv[1]))["resumePhaseA"]
b = json.load(open(sys.argv[2]))["resumePhaseB"]
keys = ("level", "freeUndosLeft", "extraSlotCount", "fingerprint")
bad = [k for k in keys if a[k] != b[k]]
print(f"level {b['level']}, {b['freeUndosLeft']} free undo(s), "
      f"{b['extraSlotCount']} extra slot(s)" if not bad else "differ: " + ", ".join(bad))
sys.exit(1 if bad else 0)
PY
)"; then
        record "phase A = phase B ($scenario)" PASS "$note"
      else
        record "phase A = phase B ($scenario)" FAIL "$note"
      fi
    fi
  fi
}

if wants resume; then
  section "Kill mid-level and resume (fresh installs)"
  resume_pair l3 "play level 3"
  resume_pair l1 "one move on level 1 (E9)"
fi

# ── 5. The daily puzzle ────────────────────────────────────────────────────
if wants daily; then
  section "Daily puzzle ($DAILY_DATE)"
  if run_step "daily_fingerprint_test" daily \
    drive daily_fingerprint_test.dart --dart-define=NESTY_FAKE_DATE="$DAILY_DATE" --timeout 600; then
    response_to "$OUT/daily.json"
    run_step "the core's level for $DAILY_DATE" core_daily \
      dart run nesty_tools:nesty_levels generate --daily "$DAILY_DATE" --out "$OUT/core_daily"
    if note="$(python3 - "$OUT/daily.json" "$OUT/core_daily/daily-$DAILY_DATE.json" <<'PY'
import json, sys
device = json.loads(json.load(open(sys.argv[1]))["dailyFingerprint"]["fingerprint"])
core = json.load(open(sys.argv[2]))
same = device == core
print(f"{device['id']}, seed {device['seed']}" + ("" if same else ": differs from the core's"))
sys.exit(0 if same else 1)
PY
)"; then
      record "device daily = nesty_core daily" PASS "$note"
    else
      record "device daily = nesty_core daily" FAIL "$note"
    fi
  fi
fi

# ── 6. M7 phase 4's device files and the daily gift's (fresh installs) ─────
# One step per file (and per scenario), each from a fresh install: every one
# seeds its own save (`integration_test/support/seeded_save.dart`) or needs a
# fresh one. Its response data is kept as <step>.json.
drive_fresh() { # label log-name response target extra-args...
  local label="$1" log="$2" response="$3"; shift 3
  uninstall_app
  if run_step "$label" "$log" drive "$@"; then
    response_to "$OUT/$response.json"
    return 0
  fi
  return 1
}

if wants board; then
