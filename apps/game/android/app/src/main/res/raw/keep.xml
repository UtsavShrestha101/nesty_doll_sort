<?xml version="1.0" encoding="utf-8"?>
<!--
  LocalNotificationService names the small icon by its resource string
  ("ic_notification"), which R8's resource shrinker can't see from Dart, so a
  release build would otherwise drop the drawable (E4, docs/plans/
  m7-design.md P3.10).
-->
<resources xmlns:tools="http://schemas.android.com/tools"
    tools:keep="@drawable/ic_notification" />
